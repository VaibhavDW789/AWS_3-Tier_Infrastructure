aws_region   = "ap-south-1"               // AWS region for resource creation
project_name = "AWS-3Tier-Infrastructure" // Project name for resource naming
environment  = "dev"                      // Environment name for resource naming (e.g., dev, staging, prod)
vpc_cidr     = "10.0.0.0/16"              // CIDR block for the VPC
public_subnets = {
  "public-subnet-1" = {
    cidr = "10.0.1.0/24" // CIDR block for the first public subnet
    az   = "ap-south-1a" // Availability Zone for the first public subnet
  }
  "public-subnet-2" = {
    cidr = "10.0.2.0/24" // CIDR block for the second public subnet
    az   = "ap-south-1b" // Availability Zone for the second public subnet
  }
}
private_app_subnets = {
  "private-app-subnet-1" = {
    cidr = "10.0.11.0/24" // CIDR block for the first private application subnet
    az   = "ap-south-1a"  // Availability Zone for the first private application subnet
  }
  "private-app-subnet-2" = {
    cidr = "10.0.12.0/24" // CIDR block for the second private application subnet
    az   = "ap-south-1b"  // Availability Zone for the second private application subnet
  }
}
private_db_subnets = {
  "private-db-subnet-1" = {
    cidr = "10.0.21.0/24" // CIDR block for the first private database subnet
    az   = "ap-south-1a"  // Availability Zone for the first private database subnet
  }
  "private-db-subnet-2" = {
    cidr = "10.0.22.0/24" // CIDR block for the second private database subnet
    az   = "ap-south-1b"  // Availability Zone for the second private database subnet
  }
}
instance_type           = "t3.micro"     // EC2 instance type for the application servers
key_name                = "MyKey"        // Name of the SSH key pair for accessing the EC2 instances
docker_image            = "nginx:latest" // Docker image to be used for the application container
backup_retention_period = 1              // The number of days to retain backups for the database instance